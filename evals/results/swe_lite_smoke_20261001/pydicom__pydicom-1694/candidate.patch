+    def test_suppress_invalid_tags_with_invalid_is(self):
+        """Test that errors raised while accessing a raw element's value are
+        suppressed if suppress_invalid_tags is True.
+        """
+        ds = Dataset()
+        ds.add_new(0x00100010, 'PN', 'Jane^Doe')
+        # Raw element with an invalid IS value (non-integral) that raises
+        # when converted on access
+        ds[0x00200011] = RawDataElement(
+            Tag(0x00200011), VR_.IS, 4, b'2.0 ', 0, True, True
+        )
+
+        with pytest.raises(TypeError):
+            ds.to_json_dict()
+
+        ds_json = ds.to_json_dict(suppress_invalid_tags=True)
+
+        assert ds_json.get("00200011") is None
+        assert ds_json.get("00100010") is not None
